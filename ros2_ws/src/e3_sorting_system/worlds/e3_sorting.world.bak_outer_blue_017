            <ros>
              <namespace>/e3/camera</namespace>
              <remapping>image_raw:=image_raw</remapping>
              <remapping>camera_info:=camera_info</remapping>
            </ros>
            <camera_name>overhead_camera</camera_name>
            <frame_name>overhead_camera_link</frame_name>
